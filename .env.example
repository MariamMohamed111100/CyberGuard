# Copy this file to `.env` and adjust the values.

# Secret key used by Flask sessions (generate a random string)
SECRET_KEY=change-me-to-a-random-string

# How often auto-scan runs in the background (seconds). The monitor keeps
# scanning even when no browser is open.
SCAN_INTERVAL=60

# Target subnet. Leave empty to auto-detect from the machine's interfaces.
# Example: NETWORK_SUBNET=192.168.1.0/24
NETWORK_SUBNET=

# API token accepted for authorize/unauthorize/export calls.
# Browser users log in with ADMIN_USERNAME/ADMIN_PASSWORD instead.
API_TOKEN=your-secret-token

# Dashboard login: a single admin account by default.
# Set ADMIN_USERNAME / ADMIN_PASSWORD to override.

# Set to false to disable the background continuous monitoring
AUTOSCAN_ENABLED=true

# Lightweight weak-service probes run after every scan against known ports
# (FTP anonymous login, open DNS resolver/recursion). Set to false to disable.
WEAK_SERVICE_CHECKS=true

# Network interface used by the Traffic Sniffer. Leave empty for auto-selection.
# Capturing requires administrator privileges and Npcap on Windows.
SNIFF_IFACE=